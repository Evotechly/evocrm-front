  "components": [
    {
      "name": "Button primary",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Built shared primary action variant.",
      "html": "<button class=\"ds-button ds-button-primary\">Créer un contact</button>",
      "css": ".ds-button:hover:not(:disabled) {\n  background: var(--color-canvas-soft);\n  border-color: var(--color-muted);\n}\n.ds-button-primary {\n  color: var(--color-on-action);\n  background: var(--color-action);\n  border-color: transparent;\n}\n.ds-button-primary:hover:not(:disabled) {\n  background: var(--color-voltage-deep);\n  border-color: transparent;\n}\n.ds-button { font-family: var(--font-sans); cursor: pointer; }\n.ds-button:focus-visible { outline: 2px solid var(--color-focus); outline-offset: 3px; }"
    },
    {
      "name": "Button default",
      "kind": "button",
      "refersTo": "button-default",
      "description": "Built shared default action variant.",
      "html": "<button class=\"ds-button\">Exporter</button>",
      "css": ".ds-button:hover:not(:disabled) {\n  background: var(--color-canvas-soft);\n  border-color: var(--color-muted);\n}\n.ds-button { font-family: var(--font-sans); cursor: pointer; }\n.ds-button:focus-visible { outline: 2px solid var(--color-focus); outline-offset: 3px; }"
    },
    {
      "name": "Button ghost",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Built shared ghost action variant.",
      "html": "<button class=\"ds-button ds-button-ghost\">Voir le contact</button>",
      "css": ".ds-button:hover:not(:disabled) {\n  background: var(--color-canvas-soft);\n  border-color: var(--color-muted);\n}\n.ds-button-ghost {\n  background: transparent;\n  border-color: transparent;\n  color: var(--color-brand);\n}\n.ds-button { font-family: var(--font-sans); cursor: pointer; }\n.ds-button:focus-visible { outline: 2px solid var(--color-focus); outline-offset: 3px; }"
    },
    {
      "name": "Button soft",
      "kind": "button",
      "refersTo": "button-soft",
      "description": "Built shared soft action variant.",
      "html": "<button class=\"ds-button ds-button-soft\">Aperçu</button>",
      "css": ".ds-button:hover:not(:disabled) {\n  background: var(--color-canvas-soft);\n  border-color: var(--color-muted);\n}\n.ds-button-soft {\n  background: var(--color-voltage-soft);\n  color: var(--color-indigo);\n  border-color: transparent;\n}\n.ds-button { font-family: var(--font-sans); cursor: pointer; }\n.ds-button:focus-visible { outline: 2px solid var(--color-focus); outline-offset: 3px; }"
    },
    {
      "name": "Button danger",
      "kind": "button",
      "refersTo": "button-danger",
      "description": "Built shared danger action variant.",
      "html": "<button class=\"ds-button ds-button-danger\">Supprimer</button>",
      "css": ".ds-button:hover:not(:disabled) {\n  background: var(--color-canvas-soft);\n  border-color: var(--color-muted);\n}\n.ds-button-danger {\n  background: var(--color-danger-soft);\n  color: var(--color-danger);\n  border-color: transparent;\n}\n.ds-button { font-family: var(--font-sans); cursor: pointer; }\n.ds-button:focus-visible { outline: 2px solid var(--color-focus); outline-offset: 3px; }"
    },
    {
      "name": "Field",
      "kind": "input",
      "refersTo": "input",
      "description": "Visible-label native record field.",
      "html": "<label class=\"ds-field\"><span>Entreprise</span><input placeholder=\"Nom de l’entreprise\"></label>",
      "css": ".ds-field {\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n  min-width: 0;\n  font-size: 12px;\n}\n.ds-field > span {\n  font-weight: 500;\n  color: var(--color-muted-strong);\n}\n.ds-field input,\n.ds-field select,\n.ds-field textarea {\n  width: 100%;\n  min-height: 38px;\n  border: 1px solid var(--color-border-strong);\n  border-radius: var(--radius-sm);\n  padding: 9px 11px;\n  background: var(--color-surface);\n  color: var(--color-ink);\n  font-size: 13px;\n}\n.ds-field { font-family: var(--font-sans); }\n.ds-field input:focus-visible { outline: 2px solid var(--color-focus); outline-offset: 3px; }"
    },
    {
      "name": "Selected navigation",
      "kind": "nav",
      "refersTo": "nav-active",
      "description": "Active relationship navigation with hover and visible keyboard focus.",
      "html": "<nav aria-label=\"Navigation principale\"><button class=\"ds-nav-item ds-active\" aria-current=\"page\">Contacts</button></nav>",
      "css": ".ds-nav-item {\n  width: 100%;\n  display: flex;\n  align-items: center;\n  gap: 11px;\n  min-height: 42px;\n  padding: 10px 12px;\n  border: 0;\n  border-radius: var(--radius-sm);\n  background: transparent;\n  color: var(--color-muted-strong);\n  text-align: left;\n  font-size: 13px;\n  transition: background var(--motion-fast) var(--ease-standard);\n}\n.ds-nav-item:hover {\n  background: var(--color-canvas-soft);\n}\n.ds-nav-item.ds-active {\n  background: var(--color-brand-soft);\n  color: var(--color-brand);\n  font-weight: 600;\n}\n.ds-nav-item { font-family: var(--font-sans); cursor: pointer; }\n.ds-nav-item:focus-visible { outline: 2px solid var(--color-focus); outline-offset: 3px; }"
    },
    {
      "name": "Success status",
      "kind": "chip",
      "refersTo": "badge-success",
      "description": "Compact text-and-dot status, not an interactive control.",
      "html": "<span class=\"ds-badge ds-badge-success\">Accepté</span>",
      "css": ".ds-badge {\n  display: inline-flex;\n  align-items: center;\n  gap: 5px;\n  padding: 3px 7px;\n  border-radius: 5px;\n  background: var(--color-canvas-soft);\n  color: var(--color-muted-strong);\n  font-size: 10px;\n  font-weight: 500;\n  white-space: nowrap;\n}\n.ds-badge:before {\n  content: '';\n  width: 5px;\n  height: 5px;\n  border-radius: 50%;\n  background: currentColor;\n}\n.ds-badge-success {\n  background: var(--color-success-soft);\n  color: var(--color-success);\n}\n.ds-badge { font-family: var(--font-sans); }"
    },
    {
      "name": "Work panel",
      "kind": "card",
      "refersTo": "panel",
      "description": "Flat hairline-framed work surface with a labeled header.",
      "html": "<section class=\"ds-panel\"><header class=\"ds-panel-header\"><h2>Contacts à suivre</h2></header><div class=\"ds-panel-padding\">Relations et prochaines actions</div></section>",
      "css": ".ds-panel-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 16px;\n  min-height: 60px;\n  padding: 16px 20px;\n  border-bottom: 1px solid var(--color-border);\n}\n.ds-panel-header h2 {\n  margin: 0;\n  font-size: 14px;\n}\n.ds-panel-padding {\n  padding: 20px;\n}\n.ds-panel-header {\n    padding: 16px;\n  }\n.ds-panel-header h2 {\n    font-size: 13px;\n  }\n.ds-panel { color: var(--color-ink); font: 14px/1.5 var(--font-sans); }"
    },
    {
      "name": "Demonstration banner",
      "kind": "custom",
