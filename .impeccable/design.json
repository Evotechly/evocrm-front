  "narrative": {
    "northStar": "Aurora Light Cabinet",
    "overview": "Aurora Light Cabinet applies Evotechly’s established Aurora identity to dense CRM work: quiet precision with voltage. Teal carries company identity and relationships; indigo carries the primary action. Cool workspaces, clear labels and restrained hairlines keep records readable.\n\nThis records the built five-screen system and shared UI, grounded in Evotechly/Brandbook 1.1.0 and the verified source in docs/research/aurora-brandbook-source.json. HubSpot and Salesforce references inform object views, relationship context and modular sales analysis; their branding and imagery are not adopted. The prior cream/monochrome treatment was explicitly rejected. User visual approval and five approved Figma comparisons remain pending; documentation is not visual acceptance.",
    "keyCharacteristics": [
      "Teal identity and selected relationships; voltage indigo actions.",
      "Cool neutral panels in matched light and night themes.",
      "Geist Sans interface; Geist Mono and tabular monetary values.",
      "Compact controls, readable scopes and honest local-demo state."
    ],
    "rules": [
      {
        "name": "Role Separation",
        "body": "Keep teal for identity and relationships, indigo for primary action and focus, and semantic colors for actual state.",
        "section": "colors"
      },
      {
        "name": "Financial Precision",
        "body": "Render actual amounts in Geist Mono with tabular figures and the shared DZD formatter’s two decimal places; keep complete amounts visible at small widths.",
        "section": "typography"
      },
      {
        "name": "Hairlines First",
        "body": "Separate resting work surfaces with tonal layers and hairlines. Reserve shadows for popovers, notifications and overlays.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use the existing semantic custom properties so light and dark themes retain their roles.",
      "Do keep primary actions indigo and selected relationship navigation teal.",
      "Do format monetary values with formatDzd, Geist Mono and tabular figures; format complete absolute dates as DD/MM/YYYY while retaining relative labels.",
      "Do preserve full filter scope labels: desktop fields have a minimum width of 205px and become full rows on phones.",
      "Do distinguish local demonstrations and simulated replies with the demo pink roles."
    ],
    "donts": [
      "Don’t replace Aurora with HubSpot or Salesforce branding or copy their reference imagery into the product.",
      "Don’t reintroduce the rejected cream/monochrome identity.",
      "Don’t introduce marketing mesh into operational record cards.",
      "Don’t imply server persistence, real sending or invented historic financial performance.",
      "Don’t treat automated checks or this document as user visual approval."
    ]
  }
