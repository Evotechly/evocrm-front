{
  "name": "@evotechly/ui",
  "version": "0.3.0",
  "description": "EvoUI 0.3.0 \u2014 unpublished Brandbook PR #13 snapshot for EvoCRM. Do not publish. Dist rebuilt from vendored src so the 113-component AGENTS.md surface is the package entry.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Evotechly/Brandbook.git",
    "directory": "packages/ui"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./src/styles.css",
    "./catalog.json": "./src/catalog.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "docs",
    "NOTICE",
    "AGENTS.md",
    "llms.txt",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsup && node ./scripts/build-css.mjs",
    "dev": "vite --config showcase/vite.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
